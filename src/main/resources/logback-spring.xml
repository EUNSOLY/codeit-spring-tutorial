        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} %replace([%X{requestedIp}] ){'^\[\] ',
                ''}%replace([%X{requestedUserId}] ){'^\[\] ', ''}- %msg%n
            </pattern>
        </encoder>
    </appender>

